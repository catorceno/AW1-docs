CORS_ORIGINS=https://todo-camila.duckdns.org,https://www.todo-camila.duckdns.org

# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
POSTGRES_PORT=5432
WEB_PORT=5001
SECRET_KEY=change-me-in-production

# Signs the login tokens. Different from SECRET_KEY, at least 32 bytes.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-another-random-64-char-hex-string
JWT_EXPIRES_MINUTES=60
FLASK_DEBUG=0

# Used when running Flask locally (outside Docker) against the compose Postgres:
DATABASE_URL=postgresql://todo:todo@localhost:5432/todo
