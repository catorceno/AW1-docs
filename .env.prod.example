SECRET_KEY=pega-aqui-una-clave-aleatoria-larga

POSTGRES_USER=todo
POSTGRES_PASSWORD=una-password-fuerte-aqui
POSTGRES_DB=todo

# Auth0: los mismos cuatro datos que en .env
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=todoapp-api
AUTH0_CLIENT_ID=your-web-app-client-id
AUTH0_CLIENT_SECRET=your-web-app-client-secret

# El sitio ya tiene HTTPS: la cookie de sesión solo viaja cifrada
SESSION_COOKIE_SECURE=1