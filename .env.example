# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todoapp
POSTGRES_PORT=5432
WEB_PORT=5001
SECRET_KEY=change-me-in-production

# Auth0: Applications > your Regular Web Application, and APIs > your API.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=todoapp-api
AUTH0_CLIENT_ID=your-web-app-client-id
# Secret: copy it from Auth0 and never commit this file.
AUTH0_CLIENT_SECRET=your-web-app-client-secret
FLASK_DEBUG=0

# Used when running Flask locally (outside Docker) against the compose Postgres:
DATABASE_URL=postgresql://todo:todo@localhost:5432/todoapp
